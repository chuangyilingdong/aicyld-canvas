[Unit]
Description=AICYLD admin site
After=network-online.target aicyld-main.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=aicyld
Group=aicyld
WorkingDirectory=/srv/aicyld/admin-prod
EnvironmentFile=/srv/aicyld/admin-prod/.env
ExecStart=/usr/bin/node /srv/aicyld/admin-prod/dist/server/index.js
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryAccounting=true
MemoryHigh=320M
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
