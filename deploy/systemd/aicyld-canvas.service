[Unit]
Description=AICYLD Canvas backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=aicyld
Group=aicyld
WorkingDirectory=/srv/aicyld/canvas
EnvironmentFile=/srv/aicyld/canvas/canvas.env
ExecStart=/srv/aicyld/canvas/bin/infinite-canvas-backend
Restart=always
RestartSec=3
LimitNOFILE=65535
TimeoutStopSec=180
MemoryAccounting=true
MemoryHigh=900M
MemoryMax=1200M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
